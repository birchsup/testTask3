{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": "./",
    "paths": {
      "@fixtures/*": ["src/fixtures/*"],
      "@api/*": ["src/api/*"],
      "@helpers/*": ["src/helpers/*"],
      "@testData/*": ["src/testData/*"],
      "@config/*": ["src/config/*"]
    },
    "rootDir": "./",
    "outDir": "dist"
  },
  "include": ["src/**/*", "playwright.config*.ts", "scripts/**/*"],
  "exclude": ["node_modules", "dist"]
}
